# ─── Docker Local Development Environment ─────────────────────────────────────
# Copy this file to .env.local and fill in your actual values.
# The docker-compose.yml will automatically use these values.
# Variables with a "(default)" comment are optional — the app uses the shown
# value when the variable is absent.

# ─── App ───────────────────────────────────────────────────────────────────────
# Public URL of the Next.js application (used for redirects and share links).
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Lumigift

# ─── Auth ──────────────────────────────────────────────────────────────────────
# URL NextAuth uses to build callback URLs — must match the running server.
NEXTAUTH_URL=http://localhost:3000
# 32-byte random secret for signing NextAuth JWTs.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your_strong_random_secret_here
# Previous NEXTAUTH_SECRET — keep during key rotation; leave blank otherwise.
NEXTAUTH_SECRET_PREVIOUS=
# Hours to accept tokens signed with NEXTAUTH_SECRET_PREVIOUS (default: 24).
NEXTAUTH_ROTATION_GRACE_HOURS=24
# CSRF token signing secret — REQUIRED, crashes on startup if absent.
# Generate with: openssl rand -hex 32
CSRF_SECRET=your_csrf_secret_here_min_32_chars

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# When using docker-compose, this is set automatically by the compose file.
DATABASE_URL=postgresql://lumigift:lumigift_dev_password@postgres:5432/lumigift
# Connection pool sizing (defaults shown).
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Redis connection URL (single-node or Sentinel proxy).
# When using docker-compose, this is set automatically by the compose file.
REDIS_URL=redis://redis:6379
# Set to "true" to enable Redis Sentinel for HA failover (default: false).
REDIS_USE_SENTINEL=false
# Comma-separated Sentinel host:port pairs — required when REDIS_USE_SENTINEL=true.
# Example: host1:26379,host2:26379
REDIS_SENTINEL_HOSTS=
# Sentinel master name (default: mymaster).
REDIS_SENTINEL_NAME=mymaster
# Sentinel authentication password — leave blank if not configured.
REDIS_SENTINEL_PASSWORD=
# Redis node authentication password — leave blank if not configured.
REDIS_PASSWORD=

# ─── Stellar / Soroban ─────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Deployed Soroban escrow contract address.
STELLAR_ESCROW_CONTRACT_ID=your_deployed_contract_id
# Server-side Stellar keypair used to sign escrow transactions.
STELLAR_SERVER_SECRET_KEY=your_stellar_secret_key
STELLAR_SERVER_PUBLIC_KEY=your_stellar_public_key
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# ─── USDC ──────────────────────────────────────────────────────────────────────
# Testnet USDC issuer — replace with mainnet issuer for production.
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ASSET_CODE=USDC

# ─── Payments ──────────────────────────────────────────────────────────────────
# Paystack — get keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=your_paystack_secret_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
# Stripe — get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
# Stripe webhook signing secret — from the Stripe webhook dashboard endpoint.
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# ─── SMS / OTP ─────────────────────────────────────────────────────────────────
# Termii — get API key from https://app.termii.com/account/api
TERMII_API_KEY=your_termii_api_key
# Sender ID registered with Termii (max 11 characters).
TERMII_SENDER_ID=Lumigift

# ─── Cron ──────────────────────────────────────────────────────────────────────
# Secret used to authenticate internal cron endpoints.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_cron_secret_min_32_chars

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (default: http://localhost:3000).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ─── Gift Amount Limits ────────────────────────────────────────────────────────
# These have safe defaults — only override if your market requires different limits.
GIFT_MIN_AMOUNT_NGN=500
GIFT_MAX_AMOUNT_NGN=500000
GIFT_DAILY_LIMIT_NGN=1000000

# ─── Cloudinary ────────────────────────────────────────────────────────────────
# Media hosting — get credentials from https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Support Chat (Crisp) ──────────────────────────────────────────────────────
# Get from https://app.crisp.chat/settings/website/
NEXT_PUBLIC_CRISP_WEBSITE_ID=your_crisp_website_id
